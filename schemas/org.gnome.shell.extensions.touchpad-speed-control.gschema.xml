<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="touchpad-speed-control">
  <schema id="org.gnome.shell.extensions.touchpad-speed-control" path="/org/gnome/shell/extensions/touchpad-speed-control/">
    <key name="app-factors" type="a{sd}">
      <default>{
        'chrome': 1.0,
        'google-chrome-stable': 1.0,
        'google-chrome-unstable': 1.0,
        'google-chrome-beta': 1.0,
        'google-chrome-dev': 1.0,
        'com.google.Chrome': 1.0,
        'com.google.Chrome.unstable': 1.0,
        'firefox': 1.0,
        'firefox-developer': 1.0,
        'firefox-nightly': 1.0,
        'org.mozilla.firefox': 1.0,
        'code': 1.0,
        'code-url-handler': 1.0,
        'org.gnome.Terminal': 1.0,
        'telegram-desktop': 1.0,
        'discord': 1.0,
        'slack': 1.0,
        'org.gnome.Nautilus': 1.0,
        'org.gnome.TextEditor': 1.0,
        'org.gnome.gedit': 1.0,
        'okular': 1.0,
        'org.gnome.Evince': 1.0,
        'com.github.johnfactotum.Foliate': 1.0,
        'org.gnome.Extensions': 1.0,
        'zotero': 1.0
      }</default>
    </key>
    <key name="global-factor" type="d">
      <default>1.0</default>
    </key>
    <key name="h-app-factors" type="a{sd}">
      <default>{
        'chrome': 1.0,
        'google-chrome-stable': 1.0,
        'google-chrome-unstable': 1.0,
        'google-chrome-beta': 1.0,
        'google-chrome-dev': 1.0,
        'com.google.Chrome': 1.0,
        'com.google.Chrome.unstable': 1.0,
        'firefox': 1.0,
        'firefox-developer': 1.0,
        'firefox-nightly': 1.0,
        'org.mozilla.firefox': 1.0,
        'code': 1.0,
        'code-url-handler': 1.0,
        'org.gnome.Terminal': 1.0,
        'telegram-desktop': 1.0,
        'discord': 1.0,
        'slack': 1.0,
        'org.gnome.Nautilus': 1.0,
        'org.gnome.TextEditor': 1.0,
        'org.gnome.gedit': 1.0,
        'okular': 1.0,
        'org.gnome.Evince': 1.0,
        'com.github.johnfactotum.Foliate': 1.0,
        'org.gnome.Extensions': 1.0,
        'zotero': 1.0
      }</default>
    </key>
    <key name="h-global-factor" type="d">
      <default>1.0</default>
    </key>
    <key name="cursor-tracking-enabled" type="b">
      <default>true</default>
    </key>
    <key name="cursor-poll-interval" type="i">
      <default>50</default>
      <range min="50" max="2000"/>
    </key>
    <key name="focus-detection-enabled" type="b">
      <default>true</default>
    </key>
    <key name="overview-global-factor" type="b">
      <default>true</default>
      <summary>Use the global factors while the overview is open</summary>
    </key>
    <key name="show-panel-indicator" type="b">
      <default>false</default>
    </key>
    <key name="scroll-gains" type="a{sd}">
      <default>{}</default>
      <summary>Measured scroll gain per app</summary>
      <description>Logical pixels an app scrolls per unit of touchpad scroll, before any factor. Written by calibration.</description>
    </key>
    <key name="scroll-reference" type="s">
      <default>''</default>
      <summary>App whose scrolling calibration matches other apps to</summary>
    </key>
    <key name="matched-apps" type="as">
      <default>[]</default>
      <summary>Apps whose factors follow the scroll reference</summary>
      <description>Their vertical and horizontal factors are recalculated from their measured gain whenever the reference app's factor changes.</description>
    </key>
    <key name="debug-logging" type="b">
      <default>false</default>
      <summary>Log detection and WSF activity to the system journal</summary>
    </key>
  </schema>
</schemalist>
